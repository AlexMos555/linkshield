{
  // Typecheck-only config: `npx tsc -p tsconfig.typecheck.json --noEmit`.
  //
  // Two copies of @types/react live in this workspace — landing's ^19 hoists
  // to the repo root (19.2), mobile pins ~19.1 for Expo SDK 54 (it pinned
  // ~18.3 on SDK 52). Packages that hoist to the root (@expo/vector-icons
  // among them) are then typed against the root copy while the app is typed
  // against its own, and on SDK 52 every <Ionicons /> failed with TS2786
  // "cannot be used as a JSX component".
  //
  // The mapping below pins one React for the compile. It deliberately does NOT
  // live in tsconfig.json: Expo's Metro reads that file's `paths` for real
  // module resolution (experiments.tsconfigPaths is on by default since SDK 52),
  // so putting it there makes the bundler resolve the `react` *module* to a
  // types-only directory and the app dies at startup with
  // "While trying to resolve module `react`". Verified the hard way.
  //
  // SDK 58 (react 19.3 / react-native 0.88): landing keeps react 19.2 at the
  // root, so npm nests mobile's react-native under mobile/node_modules while
  // many expo-* packages still hoist to the root. Their `import "react-native"`
  // then finds no react-native (CI) or a stale one further up the disk, so the
  // compile pins react-native the same way it pins react.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"]
    }
  }
}

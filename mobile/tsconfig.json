{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer pulls in every @types package by default; the app
    // imports Node's "events" and "punycode" (bundled for React Native), whose
    // declarations come from @types/node.
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  }
}

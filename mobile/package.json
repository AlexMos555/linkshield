{
  "name": "cleanway-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:ios": "eas build -p ios",
    "build:android": "eas build -p android",
    "postinstall": "node scripts/apply-patches.js"
  },
  "dependencies": {
    "@cleanway/api-client": "*",
    "@cleanway/api-types": "*",
    "@sentry/react-native": "~7.2.0",
    "events": "^3.3.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.15.0",
    "punycode": "^2.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.0.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-purchases": "~10.11.0",
    "react-native-reanimated": "~3.19.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "patch-package": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-notifications"
        ]
      }
    },
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  }
}

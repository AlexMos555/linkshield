# Cleanway mobile — build-time public env. Copy to `mobile/.env` (git-ignored)
# and fill the anon key. Expo/Metro inlines every EXPO_PUBLIC_* var into the
# bundle at build time, so this file makes auth + sync work for LOCAL
# `gradlew assembleRelease` builds (not just EAS cloud builds, which read
# eas.json). Without EXPO_PUBLIC_SUPABASE_ANON_KEY set somewhere, sign-in and
# family/sync are dead — the app boots but every auth call fails fast.

EXPO_PUBLIC_API_URL=https://api.cleanway.ai

EXPO_PUBLIC_SUPABASE_URL=https://bpyqgzzclsbfvxthyfsf.supabase.co

# The PUBLIC anon key (a JWT starting with "eyJ..."). Copy it from the Supabase
# dashboard → Project Settings → API → "Project API keys" → anon / public.
# This key is safe to embed in the app — every web page already ships it, and
# all real access is gated server-side by Row-Level Security. It is NOT the
# service_role key (never put that in the app).
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ_REPLACE_WITH_PUBLIC_ANON_KEY

# ─── OPTIONAL: captcha on the sign-in code request ────────────────────────
# Leave this UNSET (the default) and nothing changes: no captcha, no browser
# hop, no extra request, the OTP call is byte-for-byte what it has always been.
# The whole feature is dead code until this variable has a value.
#
# Set it only AFTER Supabase captcha protection is turned on
# (Dashboard → Authentication → Settings → Enable Captcha protection). Point it
# at the hosted challenge page, which renders the widget and redirects back to
# `cleanway://captcha-return?nonce=…&token=…`:
#
#   EXPO_PUBLIC_CAPTCHA_URL=https://cleanway.ai/auth/captcha
#
# Must be https:// — any other scheme is rejected and the feature stays off,
# because this value is handed to Linking.openURL.
#
# Two things to know before flipping the Supabase switch:
#  1. It is PROJECT-WIDE, not per-client. It starts requiring a token from the
#     landing sign-up form at the same instant, so wire NEXT_PUBLIC_TURNSTILE_SITE_KEY
#     on the web in the same pass or web sign-up breaks.
#  2. EXPO_PUBLIC_* is inlined at BUILD time, so turning captcha on needs a new
#     APK. Already-installed builds send no token and get `captcha_failed` —
#     the app names that case ("update the app") instead of showing a generic
#     error, but they cannot sign in until they update.

# ─── Which store this build is for (OPTIONAL; default: site) ─────────────
# site    — the APK from cleanway.ai: the paywall links to the web checkout,
#           the app offers its own updates.
# play    — Google Play: pays ONLY through Google Play billing (RevenueCat),
#           no web-checkout link anywhere, no self-update banner. Also decides
#           whether the RevenueCat native SDK (and the BILLING permission) is
#           linked at all (react-native.config.js), so it must be set for the
#           WHOLE build: prebuild, gradle and the JS bundle — this file or the
#           EAS profile, not just the shell of one step.
# rustore — RuStore: no web-checkout link; paying in the app "coming soon".
# appstore — the iPhone app. Optional: every iOS build is the App Store build
#           whatever this says (no web checkout, no self-update, App Store
#           billing). See docs/IOS.md.
#
#   EXPO_PUBLIC_DISTRIBUTION=play
#
# The PUBLIC Google Play key of the RevenueCat project (starts with goog_):
# RevenueCat → Project settings → API keys → the Play Store app. Read only by
# the play build. Without it the paywall says "paying in the app is coming
# soon" (no crash). A secret key (sk_…) is refused — it belongs on the server
# only (REVENUECAT_SECRET_API_KEY). See docs/runbooks/revenuecat.md §5.
#
#   EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_REPLACE_WITH_PUBLIC_PLAY_KEY
#
# The PUBLIC App Store key of the same RevenueCat project (starts with appl_),
# read only by iOS builds. Without it the iPhone paywall says "paying in the
# app is coming soon". A secret key or the goog_ key is refused on iOS.
#
#   EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_REPLACE_WITH_PUBLIC_APP_STORE_KEY

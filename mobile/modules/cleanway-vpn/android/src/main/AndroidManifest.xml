<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility (Android 11+): the link guard forwards tapped links
         to a real browser and must be able to SEE one. Expo's app template
         declares https only; we handle http links too, so declare both. Merged
         into the app manifest at build time. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <!-- "An app asks me to turn off the VPN": the person picks it from the
             apps on their home screen (AppExclusions). Apps with a launcher
             icon only — not QUERY_ALL_PACKAGES. The list stays on the phone. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Every app in assets/vpn_exclusions.json (AppExclusionsTest keeps the
             two in step): the shield must see whether one is installed, even if
             it has no launcher icon. -->
        <package android:name="ru.oneme.app" />
        <package android:name="ru.rostel" />
        <package android:name="ru.sberbankmobile" />
        <package android:name="ru.vtb24.mobilebanking.android" />
        <package android:name="com.idamob.tinkoff.android" />
        <package android:name="ru.alfabank.mobile.android" />
        <package android:name="ru.letobank.Prometheus" />
        <package android:name="ru.rshb.dbo" />
        <package android:name="ru.gazprombank.android.mobilebank.app" />
        <package android:name="ru.sovcomcard.halva.v1" />
        <package android:name="logo.com.mbanking" />
        <package android:name="ru.raiffeisennews" />
        <package android:name="ru.ozon.app.android" />
        <package android:name="com.wildberries.ru" />
        <package android:name="com.avito.android" />
        <package android:name="com.vkontakte.android" />
        <package android:name="ru.ok.android" />
        <package android:name="com.yandex.searchapp" />
        <package android:name="ru.yandex.searchplugin" />
        <package android:name="ru.mts.mymts" />
        <package android:name="ru.lewis.dbo" />
        <package android:name="ru.ozon.fintech.finance" />
        <package android:name="ru.wildberries.bank" />
        <package android:name="ru.vk.store" />
    </queries>

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- The shield reads the underlying network's DNS servers (UnderlyingNetworks).
       Already merged in from a library; declared here because we depend on it. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application>
    <service
      android:name="ai.cleanway.app.CleanwayVpnService"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="specialUse"
      android:exported="false">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="vpn" />
    </service>
    <!--
      Link guard: registers as an http/https handler so a tapped link (from any
      app) can be routed through Cleanway. Transparent + finishes immediately —
      it decides locally and either hands off to the branded warning screen or
      forwards to a real browser. exported=true because other apps send it links.
    -->
    <activity
      android:name="ai.cleanway.app.LinkGuardActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="http" />
        <data android:scheme="https" />
      </intent-filter>
    </activity>
    <!-- Background check of a link the guard let open. Short-lived: runs only
         while a check is in flight, with or without the VPN shield. -->
    <service
      android:name="ai.cleanway.app.LinkCheckService"
      android:exported="false" />

    <!--
      Runs in its own lightweight process. The main process is a React Native
      app whose Application.onCreate takes ~15s on a cold boot (Firebase,
      Sentry, SoLoader, the JS runtime) — far past the ~10s a broadcast
      receiver is given, so the receiver was being killed before its code ran.
      ":boot" starts a bare process that only reads a flag and starts the
      service.
    -->
    <!-- The retired "Not a scam — allow it" button of block notifications
         posted by 1.0.2: allows nothing now, only says where allowing lives
         (AllowReceiver). Not exported: only our own PendingIntent can fire it. -->
    <receiver
      android:name="ai.cleanway.app.AllowReceiver"
      android:enabled="true"
      android:exported="false" />
    <receiver
      android:name="ai.cleanway.app.BootReceiver"
      android:process=":boot"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>
    <!-- Woken by AlarmManager to keep the blocklist fresh through Doze. Runs
         in the main process so it can poke the already-running VPN service. -->
    <receiver
      android:name="ai.cleanway.app.BlocklistRefreshReceiver"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="ai.cleanway.BLOCKLIST_REFRESH" />
      </intent-filter>
    </receiver>
  </application>
</manifest>

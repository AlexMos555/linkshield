<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility (Android 11+): the link guard forwards tapped links
         to a real browser and must be able to SEE one. Expo's app template
         declares https only; we handle http links too, so declare both. Merged
         into the app manifest at build time. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- The shield reads the underlying network's DNS servers (UnderlyingNetworks).
       Already merged in from a library; declared here because we depend on it. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- "Keep protection on" (KeepAlive.requestBatteryExemption): lets the app
       show Android's one-question "stop optimising battery for Cleanway?"
       dialog instead of sending the person through a list of every app.
       A normal permission; Play allows it for safety apps whose core function
       battery optimisation breaks — an always-on scam shield killed overnight
       is exactly that. Justification: docs/MOBILE_AUTO_PROTECTION.md
       "Keeping the shield alive". Pinned by check-android-permissions.mjs. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <application>
    <service
      android:name="ai.cleanway.app.CleanwayVpnService"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="specialUse"
      android:exported="false">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="vpn" />
    </service>
    <!--
      Link guard: registers as an http/https handler so a tapped link (from any
      app) can be routed through Cleanway. Transparent + finishes immediately —
      it decides locally and either hands off to the branded warning screen or
      forwards to a real browser. exported=true because other apps send it links.
    -->
    <activity
      android:name="ai.cleanway.app.LinkGuardActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="http" />
        <data android:scheme="https" />
      </intent-filter>
    </activity>
    <!-- Background check of a link the guard let open. Short-lived: runs only
         while a check is in flight, with or without the VPN shield. -->
    <service
      android:name="ai.cleanway.app.LinkCheckService"
      android:exported="false" />

    <!--
      Runs in its own lightweight process. The main process is a React Native
      app whose Application.onCreate takes ~15s on a cold boot (Firebase,
      Sentry, SoLoader, the JS runtime) — far past the ~10s a broadcast
      receiver is given, so the receiver was being killed before its code ran.
      ":boot" starts a bare process that only reads a flag and starts the
      service.
    -->
    <!-- The retired "Not a scam — allow it" button of block notifications
         posted by 1.0.2: allows nothing now, only says where allowing lives
         (AllowReceiver). Not exported: only our own PendingIntent can fire it. -->
    <receiver
      android:name="ai.cleanway.app.AllowReceiver"
      android:enabled="true"
      android:exported="false" />
    <receiver
      android:name="ai.cleanway.app.BootReceiver"
      android:process=":boot"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <!-- Exempt from the background foreground-service start rules and
             still delivered to manifest receivers on Android 8+; a chance to
             re-arm a shield an OEM killed (see BootReceiver). -->
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- Re-arms a shield the person left ON that something else stopped (an
         OEM battery manager killing the process). Periodic JobScheduler job,
         main process; scheduled when the tunnel comes up, cancelled when the
         person turns protection off. See ShieldWatchdog. -->
    <service
      android:name="ai.cleanway.app.ShieldWatchdog"
      android:permission="android.permission.BIND_JOB_SERVICE"
      android:exported="false" />
    <!-- Woken by AlarmManager to keep the blocklist fresh through Doze. Runs
         in the main process so it can poke the already-running VPN service. -->
    <receiver
      android:name="ai.cleanway.app.BlocklistRefreshReceiver"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="ai.cleanway.BLOCKLIST_REFRESH" />
      </intent-filter>
    </receiver>
  </application>
</manifest>

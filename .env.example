# ═══════════════════════════════════════════════════
# Cleanway — Environment Configuration
# Copy to .env and fill in your values. Do NOT commit .env
# ═══════════════════════════════════════════════════

# App
DEBUG=false

# ── Supabase ──
# Get from: https://supabase.com/dashboard → Settings → API Keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API keys (preferred). The secret key is server-only — never in the
# app, the site or the extension. Startup refuses a publishable key here.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy JWT keys — used only while the new ones above are empty. Remove
# once legacy keys are disabled (docs/runbooks/supabase-jwt-signing-keys.md).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Legacy HS256 secret: no longer verifies tokens (the API uses the project's
# JWKS); only the HMAC fallback below until the dedicated keys are set.
SUPABASE_JWT_SECRET=your-jwt-secret-min-32-characters-long
# Emergency only: also accept legacy HS256 tokens (default off).
# SUPABASE_ALLOW_LEGACY_HS256=1
# Dedicated HMAC keys (fall back to SUPABASE_JWT_SECRET while unset).
UNSUBSCRIBE_HMAC_KEY=
AUDIT_IP_HASH_KEY=
# Retention purge (deleted accounts after 30 days, audit_log after 2 years,
# weekly aggregates after 1 year, expired family alerts/invites):
# off (default) | dry_run (count + log only) | on. docs/runbooks/data-retention.md
RETENTION_PURGE=off
# Management API token (for scripts, migrations, project admin)
SUPABASE_ACCESS_TOKEN=sbp_...

# ── Redis ──
# Local: redis://localhost:6379
# Upstash: rediss://default:PASSWORD@HOST:PORT
# Railway addon: rediss://default:PASSWORD@HOST.railway.app:PORT
REDIS_URL=redis://:cleanway_dev@localhost:6379

# ── Google Safe Browsing ──
# Get from: https://console.cloud.google.com/apis/credentials
# Either env var name is accepted (api/config.py uses AliasChoices).
# _API_KEY is the preferred / industry-standard form going forward.
# Safe Browsing's terms bar commercial use without a separate agreement:
# for a paid product use Web Risk below instead (docs/THIRD_PARTY_FEEDS.md).
GOOGLE_SAFE_BROWSING_API_KEY=

# ── Google Web Risk (Lookup API) — the commercial replacement ──
# Needs a Google Cloud project with billing (free to 100k lookups/month).
# Set: the analyzer asks Web Risk (api/services/web_risk.py) instead of
# Safe Browsing v4. Unset (default): Safe Browsing v4 as before.
WEB_RISK_API_KEY=

# ── Licence switches (plan §4, docs/THIRD_PARTY_FEEDS.md) ──
# API: which threat-intel lookups the analyzer consults.
#   licensed  (default since 2026-10-21) without SURBL, Spamhaus DBL public
#             mirror, URLhaus, ThreatFox, MalwareBazaar, Feodo Tracker (free
#             tiers are non-commercial; abuse.ch's APIs answer 401 without
#             a personal key). Not consulted at all: they leave the check
#             total, so the confidence figure stays honest (13 of 13).
#   all       every source — opt-in, not-for-profit deployments only
LICENSED_INTEL=licensed
# Blocklist refresh job (scripts/refresh_dangerous_domains.py), not the API
# (URLhaus is retired from it for good since 2026-10-21):
#   BLOCKLIST_LICENSED_ONLY=1  leaves OpenPhish and phishing.army
#                              out of the phone's list (default unset = all).
#                              Flip with one --force publish (churn > 50%).
#   BLOCKLIST_EXCLUDE_FEEDS=   comma-separated feed names to leave out —
#                              for measurements (scripts/eval_day_one_coverage.py)
BLOCKLIST_LICENSED_ONLY=
BLOCKLIST_EXCLUDE_FEEDS=

# ── PhishTank (optional) ──
# API: the checkurl lookup. Refresh job: with a key PhishTank's verified-
# online dump becomes a blocklist SOURCE (one cached download a day,
# api/services/phishtank_feed.py) — and stops being our held-out benchmark.
# Registration is closed at the moment (write to Cisco/OpenDNS).
PHISHTANK_API_KEY=

# ── IPQualityScore (optional, 5K/month free) ──
IPQUALITYSCORE_KEY=

# ── CORS ──
# Список доменов через запятую. Для extensions — chrome-extension://EXTENSION_ID
ALLOWED_ORIGINS=https://cleanway.ai,https://www.cleanway.ai,chrome-extension://YOUR_EXTENSION_ID

# ── Rate Limits ──
FREE_TIER_DAILY_LIMIT=10
PAID_TIER_DAILY_LIMIT=10000
BURST_LIMIT=10
BURST_WINDOW_SECONDS=10
# When Redis is unreachable:
#   false (default, dev/staging) → log + allow request (fail-open)
#   true  (set in PROD)         → return 503 (fail-closed)
# Without `true` in prod, an attacker who notices Redis is down can bypass
# our quotas and burn paid 3rd-party API budgets (Google Safe Browsing,
# IPQualityScore, etc.) until Redis recovers.
RATE_LIMIT_FAIL_CLOSED=false

# Benchmark bypass token (optional). When set, a request carrying a matching
# X-Cleanway-Benchmark header skips the public-endpoint IP rate limit. Used
# ONLY by the weekly fresh-URL benchmark CI job so it can measure a large
# sample without throttling. Leave empty in normal deployments. To enable
# weekly auto-refresh of docs/benchmarks/latest.json, set the SAME random
# value here (Railway env) and in the GitHub Actions repo secret
# BENCHMARK_BYPASS_TOKEN. Rotate by changing both.
BENCHMARK_BYPASS_TOKEN=

# ── Stripe (Phase B) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Play / App Store via RevenueCat (docs/runbooks/revenuecat.md) ──
# Exact Authorization header value set on the RevenueCat webhook (long random).
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (sk_...) — "Restore purchases" + TRANSFER sync.
REVENUECAT_SECRET_API_KEY=
# Optional JSON overriding the store product → plan map (api/services/store_products.py).
REVENUECAT_PRODUCTS=
# true only on staging / while testing with Play license testers.
REVENUECAT_ACCEPT_SANDBOX=false
GOOGLE_PLAY_PACKAGE_NAME=ai.cleanway.app

# ── Sentry (optional) ──
SENTRY_DSN=

# ═══════════════════════════════════════════════════
# Client env vars (for landing / mobile / extensions)
# ═══════════════════════════════════════════════════

# ── Landing (Next.js) — prefix with NEXT_PUBLIC_ for client-side ──
# Используется в landing/app/**/*.tsx
NEXT_PUBLIC_API_URL=https://api.cleanway.ai
NEXT_PUBLIC_STRIPE_PUB_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Новый publishable-ключ (sb_publishable_…) — если задан, используется ВМЕСТО
# anon JWT (landing/lib/supabase/public-key.ts). Нужен, чтобы потом отозвать
# legacy HS256 JWT secret. Публичный, как и anon.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Кнопка «Скачать» на /android (landing/lib/apk-release.ts). Версия на странице
# берётся из имени файла в ссылке (cleanway-<версия>-<код>-arm.apk). SHA-256 —
# вся строка, которую печатает `shasum -a 256 cleanway-1.0.6-107-arm.apk`
# (хеш, два пробела, имя файла): сумма показывается, только если имя в ней
# совпадает с файлом из ссылки. Меняются вместе; после правки — Redeploy без
# build cache (NEXT_PUBLIC_* вшиваются при сборке).
# NEXT_PUBLIC_APK_URL=https://github.com/AlexMos555/linkshield/releases/download/v1.0.6/cleanway-1.0.6-107-arm.apk
# NEXT_PUBLIC_APK_SHA256=<64 hex>  cleanway-1.0.6-107-arm.apk

# ── Mobile (Expo) — prefix with EXPO_PUBLIC_ для client-side ──
# Используется в mobile/src/services/api.ts
EXPO_PUBLIC_API_URL=https://api.cleanway.ai
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# С 1.0.5: если задан, используется ВМЕСТО anon JWT (mobile/src/utils/supabase-key.ts).
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Browser Extensions (Chrome/Firefox/Safari) ──
# Extensions не используют process.env — вместо этого:
# Default: https://api.cleanway.ai (hardcoded в background/index.js и utils/api.js)
# Dev override: Options page → "API URL" поле → http://localhost:8000 → Save
# Это пишется в chrome.storage.local.api_url и перекрывает default в runtime.

# ── Security anomaly alerts (docs/runbooks/security-incident.md) ──
# Recipient of "Cleanway security: ..." emails; unset = CRITICAL log line only.
SECURITY_ALERT_EMAIL=
# Sender (must be on a Resend-verified domain). Default alerts@cleanway.ai.
SECURITY_ALERT_FROM=
# Resend API key used to send the alerts (also used when EMAIL_PROVIDER=resend).
RESEND_API_KEY=
# Optional per-event threshold overrides, 0 = rule off, e.g.:
# SECURITY_ALERT_THRESHOLD_USER_EXPORT=20
# SECURITY_ALERT_THRESHOLD_USER_EXPORT_PER_KEY=4
